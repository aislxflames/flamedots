#!/bin/bash

# Check if the user provided an argument
if [ "$#" -ne 1 ]; then
    echo "Usage: $0 <path_to_image>"
    exit 1
fi

IMAGE="$1"

# Detect theme mode from theme.sh
THEME_FILE="$HOME/.config/flames/scripts/theme.sh"
MODE="dark" # default

if grep -qi "light" "$THEME_FILE"; then
  MODE="light"
fi



# Send notification to the user
notify-send "Changing Theme" "Applying new wallpaper and updating colors, please wait until confirmation..."

# Set wallpaper
swww img "$IMAGE" --transition-type="center" --transition-step=1 --transition-fps="60"

# Generate pywal colors
wal -i "$IMAGE" -n -s -t -e

# Refresh Spotify
pywal-spicetify Dribbblish

# Use Matugen to generate Material You colors
matugen image "$IMAGE" -m "$MODE"

# Refresh swaync
pkill swaync
swaync > /dev/null 2>&1 &

# Refresh waybar
pkill waybar
~/.config/waybar/launch.sh > /dev/null 2>&1 &
~/.config/aflames/scripts/cava.sh &

cp -rf "$IMAGE" "$HOME/.config/rofi/images/a.png"
cp -rf "$IMAGE" "$HOME/.config/rofi/images/b.png"

notify-send "Theme Applied" "Wallpaper and theme updated successfully!"
