#!/bin/bash

# Detect theme mode from theme.sh
THEME_FILE="$HOME/.config/flames/scripts/theme.sh"
THEME_PATH=$(cat "$HOME/.config/flames/scripts/theme-path.sh")
MODE="dark" # default

if grep -qi "light" "$THEME_FILE"; then
  MODE="light"
fi

# Set wallpaper directory based on mode
WALL_DIR="$HOME/.config/flames/wallpaper/$THEME_PATH"

# Save current working directory
CWD=$(pwd)

# Change to wallpaper directory
cd "$WALL_DIR" || exit 1

# Handle spaces in filenames
IFS=$'\n'

# Show wallpaper selector (excluding current.*)
SELECTED_WALL=$(find . -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.png" \) ! -iname "current.*" -printf "%f\n" | while read -r a; do
  echo -en "$a\0icon\x1f$a\n"
done | rofi -dmenu -theme ~/.config/flames/rofi-themes/wallpaper-switcher.rasi -p "")

# If a wallpaper was selected, apply it
if [ -n "$SELECTED_WALL" ]; then
  # Copy the selected wallpaper to current.png
  cp -f "$SELECTED_WALL" "$HOME/.config/flames/wallpaper/$THEME_PATH/current.png"

  # Apply wallpaper using selected file (not current.png)
  walset-backend "$SELECTED_WALL"
fi

# Return to original directory
cd "$CWD" || exit 1

