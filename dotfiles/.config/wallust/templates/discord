@import url('https://refact0r.github.io/midnight-discord/build/midnight.css');

:root {
    --colors: on;

    /* =====================
       BACKGROUND
       ===================== */

    --bg-4: {{background}};
    --bg-3: {{background}};
    --bg-2: color-mix(in srgb, {{background}}, {{foreground}} 2%);
    --bg-1: color-mix(in srgb, {{background}}, {{foreground}} 4%);

    /* =====================
       TEXT
       ===================== */

    --text-1: {{foreground}};
    --text-2: {{foreground}};
    --text-3: {{color7}};
    --text-4: {{color8}};
    --text-5: {{color8}};
    --text-0: {{background}};

    /* =====================
       SOFT HOVER
       ===================== */

    --hover: color-mix(in srgb, {{background}}, {{foreground}} 4%);
    --active: color-mix(in srgb, {{background}}, {{foreground}} 7%);
    --active-2: color-mix(in srgb, {{background}}, {{foreground}} 10%);
    --message-hover: color-mix(in srgb, {{background}}, {{foreground}} 4%);

    /* =====================
       ACCENTS MINIMAL
       ===================== */

    --accent-1: {{foreground}};
    --accent-2: {{foreground}};
    --accent-3: {{foreground}};
    --accent-4: {{foreground}};
    --accent-5: {{foreground}};
    --accent-new: {{foreground}};

    /* =====================
       STATUS
       ===================== */

    --online: {{color2}};
    --idle: {{color3}};
    --dnd: {{color1}};
    --streaming: {{color5}};
    --offline: {{color8}};

    /* =====================
       ✨ VISIBLE SOFT BORDERS
       ===================== */

    --border-light: color-mix(in srgb, {{foreground}}, {{background}} 85%);
    --border: color-mix(in srgb, {{foreground}}, {{background}} 80%);
    --border-hover: color-mix(in srgb, {{foreground}}, {{background}} 75%);
    --button-border: color-mix(in srgb, {{foreground}}, {{background}} 80%);
}


/* remove hover glow only */
*:hover {
    box-shadow: none !important;
}

